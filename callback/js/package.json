        "rng",
        "oracle",
        "random-number-generator",
        "callback",
        "solana-callback",
        "cpi",
        "on-chain",
        "anchor",
        "web3",
        "blockchain",
        "nft",
        "solana-nft",
        "gaming",
        "lottery",
        "raffle",
        "casino",
        "gamblefi",
        "orao"
    ],
    "homepage": "https://github.com/orao-network/solana-vrf#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/orao-network/solana-vrf.git",
        "directory": "callback/js"
    },
    "bugs": {
        "url": "https://github.com/orao-network/solana-vrf/issues"
    },
    "author": "ORAO Network <hello@orao.network>",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "/dist"
    ],
    "scripts": {
        "build": "tsc",
        "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
        "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
