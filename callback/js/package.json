    },
    "devDependencies": {
        "@types/chai": "^5.0.1",
        "@types/mocha": "^10.0.10",
        "chai": "^5.1.2",
        "mocha": "^10.8.2",
        "prettier": "^3.4.2",
        "ts-mocha": "^10.0.0",
        "typedoc": "^0.27.4",
        "typescript": "^5.7.2"
    }
